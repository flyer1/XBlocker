{
  "manifest_version": 3,
  "name": "XBlocker",
  "version": "0.4.0",
  "description": "Fast keyboard shortcuts for blocking, liking, and controlling videos on X and Twitter.",
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
